# ROS 2 discovery. Use the same ROS_DOMAIN_ID on the control PC.
ROS_DOMAIN_ID=10
ROS_LOCALHOST_ONLY=0

# Workspace installed on the LIMO Pro.
LIMO_WORKSPACE=/home/agilex/limo_refactor_ws

# Bringup arguments.
LIMO_BASE_PORT=ttyTHS0
LIMO_USE_MECANUM=true
LIMO_USE_LIDAR=true
LIMO_USE_CAMERA=true
LIMO_USE_RF2O=false
LIMO_PUBLISH_ODOM_TF=true
LIMO_PUBLISH_CAMERA_MOUNT_TF=false
